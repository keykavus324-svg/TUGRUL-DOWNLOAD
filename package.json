{
  "name": "tugrul-download",
  "version": "1.0.2",
  "private": true,
  "description": "TUĞRUL DOWNLOAD — yt-dlp destekli, AAA kalitede video/ses indirme stüdyosu",
  "engines": { "node": ">=18" },
  "scripts": {
    "setup": "npm install --silent && npm --prefix frontend install --silent && pip install -r backend/requirements.txt",
    "build": "npm --prefix frontend run build",
    "dev": "bash scripts/dev.sh",
    "start": "bash scripts/start.sh",
    "typecheck": "npm --prefix frontend exec tsc -- --noEmit",
    "test": "python3 -m pytest backend/tests -q",
    "test:offline": "node frontend/offline-render.mjs",
    "apk": "bash scripts/build-apk.sh",
    "apk:release": "bash scripts/build-apk.sh release",
    "docker:build": "docker build -t tugrul-download .",
    "docker:run": "docker run --rm -p 8000:8000 -v \"$PWD/downloads:/app/downloads\" tugrul-download"
  }
}
